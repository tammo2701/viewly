<Window x:Class="Viewly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Viewly" Width="1240" Height="780" MinWidth="980" MinHeight="640"
        Background="#101117" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#171923" Padding="22,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock Text="Viewly" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Width="280" Margin="30,0,0,0" VerticalAlignment="Center" ToolTip="Mediathek durchsuchen" TextChanged="SearchBox_TextChanged" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="Mediathek aktualisieren" Click="Refresh_Click" />
          <Button Content="Einstellungen" Click="Settings_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="0,0,16,0" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="MEINE MEDIATHEK" FontSize="12" Foreground="#9699A8" Margin="8,6,8,12" />
          <ListBox x:Name="MediaList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="MediaList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate>
              <DockPanel Margin="6,8" LastChildFill="True">
                <Image Source="{Binding CoverPath}" Width="48" Height="68" Stretch="UniformToFill" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9A9DAB" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="LibraryHint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#A7A9B5" FontSize="12" Margin="8,12,8,4" />
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Black" CornerRadius="12" ClipToBounds="True">
          <vlc:VideoView x:Name="VideoSurface" />
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="0,12,0,0" Padding="12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Slider x:Name="ProgressSlider" Grid.Row="0" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" />
            <DockPanel Grid.Row="1" VerticalAlignment="Center">
              <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" Foreground="#A7A9B5" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="−10s" Click="Back_Click" />
                <Button x:Name="PlayButton" Content="▶  Wiedergabe" Background="{StaticResource AccentBrush}" Click="Play_Click" />
                <Button Content="+10s" Click="Forward_Click" />
              </StackPanel>
              <Button DockPanel.Dock="Right" Content="Vollbild" Click="Fullscreen_Click" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#171923" Padding="18,0">
      <TextBlock x:Name="StatusLabel" Text="Bereit" Foreground="#A7A9B5" FontSize="11" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>

