<Window x:Class="Viewly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Viewly" Width="1220" Height="780" MinWidth="900" MinHeight="580"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="MenuRow" Height="25" />
      <RowDefinition x:Name="ToolbarRow" Height="52" />
      <RowDefinition x:Name="MainRow" Height="*" />
      <RowDefinition x:Name="StatusRow" Height="28" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Menu Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="6,0">
        <MenuItem Header="_Medien">
          <MenuItem x:Name="RefreshMenuItem" Header="Mediathek _aktualisieren" Click="Refresh_Click" />
          <Separator />
          <MenuItem x:Name="SettingsMenuItem" Header="_Einstellungen" Click="Settings_Click" />
          <Separator />
          <MenuItem Header="_Beenden" Click="Exit_Click" />
        </MenuItem>
        <MenuItem Header="_Wiedergabe">
          <MenuItem x:Name="PlayMenuItem" Header="Wiedergabe/_Pause" Click="Play_Click" IsEnabled="False" />
          <MenuItem x:Name="BackMenuItem" Header="10 Sekunden _zurück" Click="Back_Click" IsEnabled="False" />
          <MenuItem x:Name="ForwardMenuItem" Header="10 Sekunden _vor" Click="Forward_Click" IsEnabled="False" />
          <Separator />
          <MenuItem x:Name="FullscreenMenuItem" Header="_Vollbild" Click="Fullscreen_Click" IsEnabled="False" />
        </MenuItem>
      </Menu>
    </Border>

    <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,0">
      <DockPanel VerticalAlignment="Center" LastChildFill="False">
        <TextBlock Text="Viewly" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Label Content="_Suchen" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0,0,6,0" />
          <TextBox x:Name="SearchBox" Width="260" VerticalAlignment="Center"
                   ToolTip="Nach Filmen oder Serien suchen"
                   AutomationProperties.Name="Filme und Serien durchsuchen"
                   TextChanged="SearchBox_TextChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="Mediathek aktualisieren" Click="Refresh_Click" />
          <Button x:Name="SettingsButton" Content="Einstellungen" Click="Settings_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid x:Name="MainContentGrid" Grid.Row="2" Margin="12">
      <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LibraryColumn" Width="300" />
      <ColumnDefinition x:Name="ColumnGap" Width="12" />
      <ColumnDefinition x:Name="PlayerColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Mediathek" FontSize="15" FontWeight="SemiBold"
                     Margin="12,10,12,8" />
          <TextBlock x:Name="LibraryHint" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                     Margin="12,8,12,10" AutomationProperties.LiveSetting="Polite" />
          <Grid>
            <ListBox x:Name="MediaList" Margin="6,0" SelectionChanged="MediaList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <Image Source="{Binding CoverPath}" Width="48" Height="68"
                           Stretch="UniformToFill" Margin="0,0,10,0"
                           AutomationProperties.Name="{Binding Title}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" FontSize="11"
                                 Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyLibraryPanel" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="18" Visibility="Visible">
              <TextBlock x:Name="EmptyLibraryTitle" Text="Mediathek wird eingelesen"
                         FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="EmptyLibraryMessage" Text="Viewly durchsucht den Ordner Media auf dem USB-Stick."
                         Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="ControlRow" Height="86" />
        </Grid.RowDefinitions>
        <Border x:Name="VideoStage" Grid.Row="0" Background="#101010" BorderBrush="#3A3A3A"
                BorderThickness="1" ClipToBounds="True">
          <vlc:VideoView x:Name="VideoSurface" Background="#101010"
                         Visibility="Collapsed" AutomationProperties.Name="Videowiedergabe">
            <Grid Background="#02000000">
            <Button x:Name="FullscreenExitButton" Content="Vollbild verlassen"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Visibility="Collapsed" Click="Fullscreen_Click"
                    AutomationProperties.Name="Vollbild verlassen" />
            </Grid>
          </vlc:VideoView>
        </Border>
        <Border Grid.Row="1" Background="#E9E9E9" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Margin="0,8,0,0" Padding="10,6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Slider x:Name="ProgressSlider" Grid.Row="0" Minimum="0" Maximum="1"
                    IsEnabled="False" AutomationProperties.Name="Wiedergabeposition"
                    ValueChanged="ProgressSlider_ValueChanged" />
            <DockPanel Grid.Row="1" VerticalAlignment="Center" LastChildFill="False">
              <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00"
                         Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                         MinWidth="112" AutomationProperties.LiveSetting="Polite" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BackButton" Content="−10 s" Click="Back_Click" IsEnabled="False"
                        AutomationProperties.Name="10 Sekunden zurückspringen" />
                <Button x:Name="PlayButton" Content="Wiedergabe" Background="{StaticResource AccentBrush}"
                        Foreground="#202020" Click="Play_Click" IsEnabled="False" />
                <Button x:Name="ForwardButton" Content="+10 s" Click="Forward_Click" IsEnabled="False"
                        AutomationProperties.Name="10 Sekunden vorspringen" />
              </StackPanel>
              <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Content="Vollbild"
                      Click="Fullscreen_Click" AutomationProperties.Name="Vollbild umschalten" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#E8E8E8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <TextBlock x:Name="StatusLabel" Text="Bereit" Foreground="{StaticResource MutedTextBrush}"
                 FontSize="11" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
