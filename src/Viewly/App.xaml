<Application x:Class="Viewly.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="PanelBrush" Color="#171923" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#292C3A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#20222D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#383B49" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Resources>
</Application>
